# Docker Desktop 访问宿主机 MySQL 使用 host.docker.internal。
# 如果 MySQL 是另一个容器，填写该服务名。
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=recall_hub
MYSQL_USERNAME=recallhub
MYSQL_PASSWORD=change_me

RECALLHUB_TIMEZONE=Asia/Shanghai

# 默认不设置，启动后在“设置 → OpenClaw”中配置。
# OPENCLAW_BASE_URL=http://OpenClaw主机:18789
# OPENCLAW_HOOK_TOKEN=replace_me

# 容器镜像默认没有 mysqldump，建议由 MySQL 容器或宿主机负责数据库备份。
BACKUP_ENABLED=false
